{
  "name": "cup-shelf-clear",
  "version": "1.0.0",
  "description": "杯柜清场 — 微信小游戏长局整理消除（核心引擎 + 预览 + 自测）",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "build:preview": "esbuild src/preview/main.ts --bundle --format=iife --outfile=preview/app.js --sourcemap && node scripts/copy-levels-to-preview.mjs",
    "preview": "npm run build:preview && npx --yes serve preview -p 5173",
    "validate:levels": "tsx scripts/validate-levels.ts",
    "typecheck": "tsc --noEmit",
    "gen:levels": "tsx scripts/gen-levels.ts",
    "build:wechat": "node scripts/build-wechat.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true
  }
}
